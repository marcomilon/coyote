---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from './Breadcrumb.astro';
import ChatThread from './ChatThread.astro';
import { t, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
  /** Spanish with vos (the pages under /vos/). */
  vos?: boolean;
}
const { lang, vos = false } = Astro.props;
const s = t(lang, vos);
const c = s.chat;
const other = t(s.otherLang.code);
const clientStrings = { ...c, question: s.questions, previewPath: s.paths.preview };
---

<Layout lang={lang} vos={vos} title={c.title} description={c.description} alternate={other.paths.chat} withConfig noindex>
  <Breadcrumb lang={lang} vos={vos} current={c.title.split(' — ')[0]} wrap />
  <div class="chat wrap" id="chat" data-state="loading" data-strings={JSON.stringify(clientStrings)}>
    <section data-view="loading" class="loader" role="status" aria-label={s.loading}><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span></section>

    <section data-view="message" class="panel" aria-live="assertive">
      <h2 data-message-title></h2>
      <p data-message-text></p>
    </section>

    <section data-view="chat">
      <header class="chat-head">
        <div>
          <p class="script">ventas314.com</p>
          <h1 data-business>{c.heading}</h1>
        </div>
        <a class="btn small ghost" data-draft-link target="_blank" rel="noopener">{c.view}</a>
      </header>
      <ChatThread lang={lang} vos={vos} />
    </section>
  </div>
</Layout>

<script>
  import '../scripts/chat';
</script>
