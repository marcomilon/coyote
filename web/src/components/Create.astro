---
import Layout from '../layouts/Layout.astro';
import { t, type Lang } from '../i18n/strings';
import { countries, countryLabel } from '../scripts/phone';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const c = s.create;
const other = t(s.otherLang.code);
// The script is language-agnostic: it reads the strings it needs from here.
const clientStrings = {
  lang, // The site is written in the language of the form.
  errors: c.errors,
  uploading: c.photos.uploading,
  uploadFailed: c.photos.failed,
  tooManyPhotos: c.photos.tooMany,
  notImage: c.photos.notImage,
  submit: c.submit,
  mySitePath: s.paths.mySite,
  question: s.questions,
  rejected: c.rejected,
  rateLimited: c.rateLimited,
  failed: c.failed,
  lostLink: c.lostLink,
  noApi: c.noApi,
  canClose: c.working.canClose,
};---

<Layout lang={lang} title={c.title} description={c.description} alternate={other.paths.create} withConfig>
  <div class="create wrap" id="create" data-state="form" data-strings={JSON.stringify(clientStrings)}>
    <section data-view="form">
      <form class="ticket" data-form novalidate>
        <header>
          <h1>{c.heading}</h1>
          <p>{c.sub}</p>
        </header>

        <fieldset>
          <label class="q" for="businessName"><i>1</i>{c.q1.label}</label>
          <input type="text" id="businessName" name="businessName" maxlength="80" autocomplete="organization" placeholder={c.q1.placeholder} required />
          <p class="count" data-count-for="businessName" aria-hidden="true"></p>
          <p class="error" data-error="businessName" role="alert"></p>
        </fieldset>

        <fieldset>
          <label class="q" for="about"><i>2</i>{c.q2.label}</label>
          <p class="hint" id="about-hint">{c.q2.hint}</p>
          <textarea id="about" name="about" maxlength="1000" aria-describedby="about-hint" placeholder={c.q2.placeholder} required></textarea>
          <p class="count" data-count-for="about" aria-hidden="true"></p>
          <p class="error" data-error="about" role="alert"></p>
        </fieldset>

        <fieldset>
          <legend class="q"><i>3</i>{c.q3.label}</legend>
          <div class="two">
            <div>
              <label class="sub" for="country">{c.q3.country}</label>
              <select id="country" name="country" data-fallback={lang === 'pt' ? 'BR' : ''}>
                <option value="">{c.q3.countryPick}</option>
                {countries(lang).map((country) => <option value={country.iso}>{countryLabel(country, lang)}</option>)}
              </select>
            </div>
            <div>
              <label class="sub" for="whatsapp">{c.q3.whatsapp}</label>
              <input type="tel" id="whatsapp" name="whatsapp" maxlength="24" autocomplete="tel-national" inputmode="tel" aria-describedby="whatsapp-hint" required />
            </div>
          </div>
          <p class="hint" id="whatsapp-hint">{c.q3.whatsappHint}</p>
          <p class="error" data-error="contact.whatsapp" role="alert"></p>
          <label class="sub" for="email">{c.q3.email}</label>
          <input type="email" id="email" name="email" maxlength="120" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" inputmode="email" placeholder={c.q3.emailPlaceholder} />
          <p class="error" data-error="contact.email" role="alert"></p>
          <label class="sub" for="address">{c.q3.address}</label>
          <input type="text" id="address" name="address" maxlength="160" autocomplete="street-address" />
          <p class="error" data-error="contact.address" role="alert"></p>
          <div class="two">
            <div>
              <label class="sub" for="instagram">{c.q3.instagram}</label>
              <input type="text" id="instagram" name="instagram" maxlength="200" placeholder={c.q3.instagramPlaceholder} autocapitalize="none" autocorrect="off" spellcheck="false" />
              <p class="error" data-error="contact.instagram" role="alert"></p>
            </div>
            <div>
              <label class="sub" for="facebook">{c.q3.facebook}</label>
              <input type="text" id="facebook" name="facebook" maxlength="200" placeholder={c.q3.facebookPlaceholder} autocapitalize="none" autocorrect="off" spellcheck="false" />
              <p class="error" data-error="contact.facebook" role="alert"></p>
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend class="q"><i>4</i>{c.goal.label}</legend>
          <div class="choices">
            {(['info', 'whatsapp', 'call', 'visit', 'book'] as const).map((goal) => (
              <label class="choice"><input type="radio" name="goal" value={goal} checked={goal === 'info'} /><span>{c.goal.options[goal]}</span></label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="q"><i>5</i>{c.photos.label}</legend>
          <p class="hint">{c.photos.hint}</p>
          {/* Uploads hidden for now (remove `hidden` to show them again); the AI photos switch stays. */}
          <div class="two" hidden>
            <div><label class="sub" for="logo">{c.photos.logo}</label><input type="file" id="logo" name="logo" accept="image/*" /></div>
            <div><label class="sub" for="photos">{c.photos.pics}</label><input type="file" id="photos" name="photos" accept="image/*" multiple /></div>
          </div>
          <p class="error" data-error="photos" role="alert"></p>
          <label class="toggle">
            <input type="checkbox" role="switch" name="aiImages" checked aria-describedby="aiImages-hint" />
            <span class="track" aria-hidden="true"></span>
            <span class="toggle-text"><span class="toggle-label">{c.aiImages.label}</span><span class="hint" id="aiImages-hint">{c.aiImages.hint}</span></span>
          </label>
        </fieldset>

        <fieldset>
          <label class="q" for="ownerEmail"><i>6</i>{c.email.label}</label>
          <p class="hint" id="ownerEmail-hint">{c.email.hint}</p>
          <input type="email" id="ownerEmail" name="ownerEmail" maxlength="120" autocomplete="email" autocapitalize="none" autocorrect="off" spellcheck="false" inputmode="email" aria-describedby="ownerEmail-hint" placeholder={c.email.placeholder} required />
          <p class="hint" data-signed-in hidden>{c.email.signedIn}</p>
          <p class="error" data-error="ownerEmail" role="alert"></p>
        </fieldset>

        <div class="submit-row">
          <button class="btn" type="submit">{c.submit}</button>
          <p>{c.terms}</p>
        </div>
        <p class="error" data-error="form" role="alert"></p>
      </form>
    </section>

    <section data-view="working" class="panel" aria-live="polite">
      <h2>{c.working.title}</h2>
      <div class="paint" aria-hidden="true"></div>
      <ol class="worksteps">{c.working.steps.map((step) => <li>{step}</li>)}</ol>
      <p class="hint"><span data-close-note>{c.working.note}</span> <span class="elapsed" data-elapsed aria-hidden="true"></span></p>
    </section>

    <section data-view="questions">
      <form class="ticket" data-questions novalidate>
        <header>
          <h2>{s.questions.title}</h2>
          <p>{s.questions.intro}</p>
        </header>
        <div data-question-list></div>
        <div class="submit-row">
          <button class="btn" type="submit">{s.questions.submit}</button>
          <button class="btn ghost" type="button" data-skip>{s.questions.skip}</button>
        </div>
      </form>
    </section>

    <section data-view="message" class="panel" aria-live="assertive">
      <h2 data-message-title></h2>
      <p data-message-text></p>
      <div class="actions"><button class="btn ghost" type="button" data-back-to-form hidden></button></div>
    </section>
  </div>
</Layout>

<script>
  import '../scripts/create';
</script>
