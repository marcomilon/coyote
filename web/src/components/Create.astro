---
import Layout from '../layouts/Layout.astro';
import { t, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const c = s.create;
const other = t(s.otherLang.code);
// The script is language-agnostic: it reads the strings it needs from here.
const clientStrings = {
  errors: c.errors,
  uploading: c.photos.uploading,
  uploadFailed: c.photos.failed,
  submit: c.submit,
  mySitePath: s.paths.mySite,
  chatPath: s.paths.chat,
  qr: c.qr,
  copied: c.done.copied,
  question: s.questions,
  rejected: c.rejected,
  rateLimited: c.rateLimited,
  failed: c.failed,
  lostLink: c.lostLink,
  noApi: c.noApi,
  canClose: c.working.canClose,
};---

<Layout lang={lang} title={c.title} description={c.description} alternate={other.paths.create} withConfig>
  <div class="create wrap" id="create" data-state="form" data-strings={JSON.stringify(clientStrings)}>
    <section data-view="form">
      <form class="ticket" data-form novalidate>
        <header>
          <h1>{c.heading}</h1>
          <p>{c.sub}</p>
        </header>

        <fieldset>
          <label class="q" for="businessName"><i>1</i>{c.q1.label}</label>
          <input type="text" id="businessName" name="businessName" maxlength="80" autocomplete="organization" placeholder={c.q1.placeholder} required />
          <p class="error" data-error="businessName" role="alert"></p>
        </fieldset>

        <fieldset>
          <label class="q" for="about"><i>2</i>{c.q2.label}</label>
          <p class="hint" id="about-hint">{c.q2.hint}</p>
          <textarea id="about" name="about" maxlength="1000" aria-describedby="about-hint" placeholder={c.q2.placeholder} required></textarea>
          <p class="error" data-error="about" role="alert"></p>
        </fieldset>

        <fieldset>
          <legend class="q"><i>3</i>{c.q3.label}</legend>
          <label class="sub" for="whatsapp">{c.q3.whatsapp}</label>
          <input type="tel" id="whatsapp" name="whatsapp" maxlength="40" autocomplete="tel" inputmode="tel" placeholder={c.q3.whatsappPlaceholder} required />
          <p class="error" data-error="contact.whatsapp" role="alert"></p>
          <label class="sub" for="address">{c.q3.address}</label>
          <input type="text" id="address" name="address" maxlength="160" autocomplete="street-address" />
          <p class="error" data-error="contact.address" role="alert"></p>
          <div class="two">
            <div>
              <label class="sub" for="instagram">{c.q3.instagram}</label>
              <input type="text" id="instagram" name="instagram" maxlength="200" placeholder="@" autocapitalize="none" />
              <p class="error" data-error="contact.instagram" role="alert"></p>
            </div>
            <div>
              <label class="sub" for="facebook">{c.q3.facebook}</label>
              <input type="text" id="facebook" name="facebook" maxlength="200" autocapitalize="none" />
              <p class="error" data-error="contact.facebook" role="alert"></p>
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend class="q"><i>+</i>{c.photos.label}</legend>
          <p class="hint">{c.photos.hint}</p>
          <div class="two">
            <div><label class="sub" for="logo">{c.photos.logo}</label><input type="file" id="logo" name="logo" accept="image/*" /></div>
            <div><label class="sub" for="photos">{c.photos.pics}</label><input type="file" id="photos" name="photos" accept="image/*" multiple /></div>
          </div>
          <p class="error" data-error="photos" role="alert"></p>
        </fieldset>

        <fieldset>
          <label class="q" for="ownerEmail"><i>4</i>{c.email.label}</label>
          <p class="hint" id="ownerEmail-hint">{c.email.hint}</p>
          <input type="email" id="ownerEmail" name="ownerEmail" maxlength="120" autocomplete="email" autocapitalize="none" inputmode="email" aria-describedby="ownerEmail-hint" placeholder={c.email.placeholder} required />
          <p class="error" data-error="ownerEmail" role="alert"></p>
        </fieldset>

        <fieldset>
          <legend class="sub">{c.siteLang}</legend>
          <div class="langs">
            <label><input type="radio" name="lang" value="es" checked={lang === 'es'} /><span>Español</span></label>
            <label><input type="radio" name="lang" value="pt" checked={lang === 'pt'} /><span>Português</span></label>
          </div>
        </fieldset>

        <div class="submit-row">
          <button class="btn" type="submit">{c.submit}</button>
          <p>{c.terms}</p>
        </div>
        <p class="error" data-error="form" role="alert"></p>
      </form>
    </section>

    <section data-view="working" class="panel" aria-live="polite">
      <h2>{c.working.title}</h2>
      <div class="paint" aria-hidden="true"></div>
      <ol class="worksteps">{c.working.steps.map((step) => <li>{step}</li>)}</ol>
      <p class="hint"><span data-close-note>{c.working.note}</span> <span class="elapsed" data-elapsed aria-hidden="true"></span></p>
    </section>

    <section data-view="questions">
      <form class="ticket" data-questions novalidate>
        <header>
          <h2>{s.questions.title}</h2>
          <p>{s.questions.intro}</p>
        </header>
        <div data-question-list></div>
        <div class="submit-row">
          <button class="btn" type="submit">{s.questions.submit}</button>
          <button class="btn ghost" type="button" data-skip>{s.questions.skip}</button>
        </div>
      </form>
    </section>

    <section data-view="done" class="storefront">
      <div class="bar">
        <div class="title">
          <p class="script">Coyote</p>
          <h2>{c.done.title}</h2>
          <p>{c.done.text}</p>
        </div>
        <a class="btn small ghost" data-draft-link target="_blank" rel="noopener">{c.done.open}</a>
      </div>
      <div class="handoff" data-handoff hidden>
        <div class="qr" data-qr></div>
        <div>
          <h3>{c.qr.title}</h3>
          <p>{c.qr.text}</p>
          <a class="linkbtn" data-chat-open target="_blank" rel="noopener">{c.qr.open}</a>
        </div>
      </div>
      <div class="magic">
        <h3>{c.magic.title}</h3>
        <p>{c.magic.text}</p>
        <div class="linkbox"><a data-magic-link></a></div>
        <div class="actions">
          <button class="btn small blue" type="button" data-magic-copy>{c.magic.copy}</button>
          <a class="btn small ghost" data-magic-whatsapp target="_blank" rel="noopener">{c.magic.whatsapp}</a>
          <a class="btn small" data-magic-open>{c.magic.open}</a>
        </div>
      </div>
      <p class="notice updated" data-updated role="status" aria-live="polite"></p>
      <div class="frame"><iframe title={c.done.title} sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"></iframe></div>
    </section>

    <section data-view="message" class="panel" aria-live="assertive">
      <h2 data-message-title></h2>
      <p data-message-text></p>
      <div class="actions"><a class="btn ghost" href={s.paths.create}>{c.failed.retry}</a></div>
    </section>
  </div>
</Layout>

<script>
  import '../scripts/create';
</script>
