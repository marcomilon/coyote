---
import Layout from '../layouts/Layout.astro';
import { t, type Lang } from '../i18n/strings';
import {
  COUNTRIES,
  DEFAULT_COUNTRY,
  EXAMPLE_PHOTOS,
  SHOW_HERO_TERMS,
  STATS,
  TESTIMONIALS,
  WHATSAPP,
  WHATSAPP_FIRST,
  whatsappLink,
} from '../config/landing';
import { CURRENCY_NAMES, formatPrice, pricesFor, type PriceKind } from '../../../services/generator/src/core/prices';
import { offers } from '../config/offers';

interface Props {
  lang: Lang;
  /** Spanish with vos (the pages under /vos/). */
  vos?: boolean;
}
const { lang, vos = false } = Astro.props;
const s = t(lang, vos);
const h = s.home;
const other = t(s.otherLang.code);
const fallback = DEFAULT_COUNTRY[lang];
// Every country's value is on the page; the country picker (scripts/landing.ts) shows one set and hides the rest.
const perCountry = (value: (c: (typeof COUNTRIES)[number]) => string) =>
  COUNTRIES.map((c) => ({ code: c.code, value: value(c), hidden: c.code !== fallback }));
// The plan's and the design pack's price, and the currency they're in, as each country pays them (core/prices.ts).
const price = (kind: PriceKind) => perCountry((c) => formatPrice(kind, c.code, lang));
const currency = perCountry((c) => CURRENCY_NAMES[pricesFor(c.code).currency][lang]);
const [subBefore, subAfter = ''] = h.pricing.sub.split('{currency}') as [string, string?];
// soporte@<domain> from astro.config.mjs (urls.ts); a domainless build has none, and the lines that name it are left out.
const support = import.meta.env.PUBLIC_SUPPORT_EMAIL as string;
const withSupport = <T extends { text?: string; a?: string }>(items: T[]) =>
  items.filter((item) => support || !(item.text ?? item.a ?? '').includes('{support}'));
const fill = (text: string) => text.replace('{support}', support);
const faq = withSupport(h.faq).map((item) => ({ q: item.q, a: fill(item.a) }));
const contact = whatsappLink(lang);
// Until owners can create a site on WhatsApp, the WhatsApp buttons open the web form.
const onboarding = (WHATSAPP.onboarding && contact) || s.paths.create;
const [primary, secondary] = WHATSAPP_FIRST
  ? [{ label: h.ctaWhatsapp, href: onboarding }, { label: h.ctaWeb, href: s.paths.create }]
  : [{ label: h.cta, href: s.paths.create }, { label: h.seeExamples, href: '#ejemplos' }];
const testimonials = TESTIMONIALS[lang];
const circles = ['amarillo', 'crema', 'verde', 'celeste', 'amarillo', 'crema'];
---

<Layout lang={lang} vos={vos} title={h.title} description={h.description} alternate={other.paths.home} withConfig home>
  {
    Astro.site && (
      <script
        is:inline
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@graph': [
            { '@type': 'Organization', '@id': new URL('/#org', Astro.site).href, name: 'ventas314.com', url: new URL('/', Astro.site).href, logo: new URL('/logo.png', Astro.site).href },
            { '@type': 'WebSite', name: 'ventas314.com', url: new URL(s.paths.home, Astro.site).href, inLanguage: s.htmlLang, description: h.description },
            {
              '@type': 'Service',
              name: h.title,
              description: h.description,
              serviceType: lang === 'es' ? 'Diseño de páginas web' : 'Criação de sites',
              provider: { '@id': new URL('/#org', Astro.site).href },
              areaServed: COUNTRIES.map((c) => ({ '@type': 'Country', name: c.code })),
              offers: offers(lang, vos, new URL(s.paths.home + '#precio', Astro.site).href),
            },
            {
              '@type': 'FAQPage',
              url: new URL(s.paths.home, Astro.site).href,
              inLanguage: s.htmlLang,
              mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
            },
          ],
        })}
      />
    )
  }
  <section class="hero wrap">
    <div class="hero-text">
      <p class="kicker">{h.kicker}</p>
      <h1>{h.headline.map((line) => <span>{line}</span>)}</h1>
      <p class="lead">{h.lead}</p>
      <div class="ctas">
        <a class="btn" href={primary.href}>{primary.label}</a>
        <a class="btn ghost" href={secondary.href}>{secondary.label}</a>
      </div>
      {SHOW_HERO_TERMS && <p class="terms">{h.terms}</p>}
    </div>

    <div class="showcase" role="group" aria-label={h.examplesLabel}>
      <div class="phone">
        {
          h.examples.map((ex, i) => (
            <div class="screen" id={`ejemplo-${i}`} style={`--bg: ${ex.color}`} hidden={i !== 0}>
              <span class="notch" />
              <div class="photo">{EXAMPLE_PHOTOS[i] && <img src={EXAMPLE_PHOTOS[i]} alt="" loading={i === 0 ? 'eager' : 'lazy'} />}</div>
              <div class="body">
                <p class="tagline">{ex.tagline}</p>
                <p class="name">{ex.name}</p>
                <ul>
                  {ex.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <p class="place">📍 {ex.place}</p>
                <span class="pill">{ex.cta}</span>
              </div>
            </div>
          ))
        }
      </div>
      <div class="example-tabs" data-example-tabs hidden>
        {
          h.examples.map((ex, i) => (
            <button type="button" aria-controls={`ejemplo-${i}`} aria-pressed={i === 0 ? 'true' : 'false'}>
              {ex.tab}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <div class="marquee">
    <div class="track">
      <ul aria-label={h.forTitle}>{h.forList.map((name) => <li>{name}</li>)}</ul>
      <ul aria-hidden="true">{h.forList.map((name) => <li>{name}</li>)}</ul>
    </div>
  </div>

  <section class="includes wrap">
    <h2>{h.includes.title.map((line) => <span>{line}</span>)}</h2>
    <p class="sub">{h.includes.sub}</p>
    <ul class="cards">
      {
        h.includes.items.map((item, i) => (
          <li class="card">
            <span class={`icon ${circles[i % circles.length]}`} aria-hidden="true">
              {item.icon}
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="extra"><span aria-hidden="true">📷</span> {h.includes.extra}</p>
  </section>

  <section class="steps wrap">
    <h2>{h.stepsTitle}</h2>
    <ol class="cards">
      {
        h.steps.map((step) => (
          <li class="card">
            <span class="n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="proof wrap" id="ejemplos">
    <div class="proof-head">
      <h2>{h.proof.title.map((line) => <span>{line}</span>)}</h2>
      {
        STATS.length > 0 && (
          <dl class="stats">
            {STATS.map((stat) => (
              <div>
                <dt>{stat.label[lang]}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
    <ul class="cards">
      {
        testimonials.map((item) => (
          <li class="card case">
            {/* landing.ts sets the href from config.js (the example's URL depends on the stack's domains). */}
            <a class="shot" data-example={item.site} target="_blank" rel="noopener">
              {item.screenshot && (
                <img src={item.screenshot} alt={h.proof.screenshot.replace('{business}', item.business.split(' · ')[0])} loading="lazy" width="1200" height="900" />
              )}
            </a>
            <figure>
              <blockquote>“{item.quote}”</blockquote>
              <figcaption>
                {/* The customer's photo, or else their country's flag (square SVGs from flag-icons, MIT, in web/public/flags). */}
                <span class="avatar">
                  {item.avatar ? (
                    <img src={item.avatar} alt="" loading="lazy" width="44" height="44" />
                  ) : (
                    <img
                      src={`/flags/${item.country.toLowerCase()}.svg`}
                      alt={COUNTRIES.find((c) => c.code === item.country)?.name[lang]}
                      loading="lazy"
                      width="44"
                      height="44"
                    />
                  )}
                </span>
                <span>
                  <b>{item.name}</b>
                  <span>{item.business}</span>
                </span>
              </figcaption>
              {item.site && (
                <a class="case-link" data-example={item.site} target="_blank" rel="noopener" hidden>
                  {h.proof.visit} ↗
                </a>
              )}
            </figure>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="pricing wrap" id="precio">
    <h2>{h.pricing.title}</h2>
    <p class="sub">
      {subBefore}
      {currency.map((v) => (
        <span data-country={v.code} hidden={v.hidden}>
          {v.value}
        </span>
      ))}
      {subAfter}
    </p>
    <div class="plans">
      <div class="card plan">
        <h3>{h.pricing.free.name}</h3>
        <p class="price">{h.pricing.free.price}</p>
        {h.pricing.free.text.map((line) => <p class="plan-text">{line}</p>)}
        <a class="btn ghost flat" href={s.paths.create}>{h.pricing.free.cta}</a>
      </div>
      <div class="card plan pro">
        <div class="plan-head">
          <h3>{h.pricing.pro.name}</h3>
          <span class="tag">{h.pricing.pro.tag}</span>
        </div>
        <p class="price">
          {price('plan').map((v) => (
            <span data-country={v.code} hidden={v.hidden}>
              {v.value}
            </span>
          ))}
          <small>{h.pricing.pro.per}</small>
        </p>
        <ul>{h.pricing.pro.features.map((f) => <li>{f}</li>)}</ul>
        <a class="btn flat" href={s.paths.create}>{h.pricing.pro.cta}</a>
      </div>
      <div class="card plan">
        <h3>{h.pricing.designs.name}</h3>
        <p class="price">
          {price('designs').map((v) => (
            <span data-country={v.code} hidden={v.hidden}>
              {v.value}
            </span>
          ))}
          <small>{h.pricing.designs.per}</small>
        </p>
        {h.pricing.designs.text.map((line) => <p class="plan-text">{line}</p>)}
      </div>
    </div>
    <h3 class="details-title">{h.pricing.details.title}</h3>
    <dl class="card plan-details">
      {
        withSupport(h.pricing.details.items).map((item) => {
          const [before, after] = fill(item.text).split('{designsPrice}') as [string, string?];
          return (
            <div>
              <dt>{item.title}</dt>
              <dd>
                {before}
                {after !== undefined && (
                  <>
                    {price('designs').map((v) => (
                      <span data-country={v.code} hidden={v.hidden}>
                        {v.value}
                      </span>
                    ))}
                    {after}
                  </>
                )}
              </dd>
            </div>
          );
        })
      }
    </dl>
    <p class="note">{h.pricing.note}</p>
  </section>

  <section class="wa-band">
    <div class="wrap">
      <div>
        <h2>{h.whatsapp.title}</h2>
        <p>{h.whatsapp.text}</p>
      </div>
      <a class="btn wa" href={onboarding}>{h.whatsapp.cta}</a>
    </div>
  </section>

  <section class="faq wrap">
    <h2>{h.faqTitle}</h2>
    <div class="faq-list">
      {
        faq.map((item, i) => (
          <details name="faq" open={i === 0}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
    <div class="faq-cta">
      <a class="btn" href={s.paths.create}>{h.cta}</a>
      {
        contact && (
          <span>
            {h.questions} <a href={contact}>{h.writeUs}</a>
          </span>
        )
      }
    </div>
  </section>
</Layout>

<script>
  import '../scripts/landing';
</script>
