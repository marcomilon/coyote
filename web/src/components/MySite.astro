---
import Layout from '../layouts/Layout.astro';
import AccountBar from './AccountBar.astro';
import ChatThread from './ChatThread.astro';
import { t, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
  /** Spanish with vos (the pages under /vos/). */
  vos?: boolean;
}
const { lang, vos = false } = Astro.props;
const s = t(lang, vos);
const m = s.mySite;
const other = t(s.otherLang.code);
const d = m.domain;
const p = m.photos;
const x = m.texts;
// The Dominio tab is hidden (global.css) unless PUBLIC_DOMAIN_TAB=on, e.g. in web/.env.development.local, which only `npm run dev` reads.
const domainTab = import.meta.env.PUBLIC_DOMAIN_TAB === 'on';
const clientStrings = { ...m, lang, question: s.questions, previewPath: s.paths.preview, chatPath: s.paths.chat, chat: { ...s.chat, question: s.questions } };
---

<Layout lang={lang} vos={vos} title={m.title} description={m.description} alternate={other.paths.mySite} withConfig noindex>
  <AccountBar slot="account" lang={lang} vos={vos} />
  <div class="mysite wrap" id="mysite" data-state="loading" data-domain-tab={domainTab ? "on" : undefined} data-strings={JSON.stringify(clientStrings)}>
    <section data-view="loading" class="loader" role="status" aria-label={s.loading}><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span></section>

    <section data-view="message" class="panel" aria-live="assertive">
      <h2 data-message-title></h2>
      <p data-message-text></p>
      {/* No session in this browser (or it expired): how to get back to the page. */}
      <div class="card recover" data-recover hidden>
        <h3>{m.recover.title}</h3>
        <ol>
          {m.recover.steps.map((step) => <li>{step}</li>)}
        </ol>
        <p class="hint">{m.recover.note}</p>
        <div><a class="btn small" href={s.paths.mySites}>{m.recover.action}</a></div>
      </div>
    </section>

    <section data-view="editor">
      <header>
        <h1 data-business>{m.heading}</h1>
        {/* The page full screen in a new tab (/ver); the tooltip says so, and that only the owner can see it. */}
        <a class="open-tab" data-draft-link target="_blank" rel="noopener" aria-label={`${m.open}. ${m.private}`} data-tip={`${m.open}. ${m.private}`}>
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a class="open-link" data-draft-link target="_blank" rel="noopener">{m.openTab}</a>
      </header>
      {/* For an owner who came from the form or the "lista" email (not from Mis páginas web): how to come back later. */}
      <details class="later" data-later hidden>
        <summary>{m.recover.later}</summary>
        <div class="recover">
          <ol>
            {m.recover.steps.map((step) => <li>{step}</li>)}
          </ol>
          <p class="hint">{m.recover.note}</p>
        </div>
      </details>
      <div class="tabs" role="tablist" aria-label={m.tabs.label}>
        <button type="button" role="tab" id="tab-preview" aria-controls="panel-preview" aria-selected="true" data-tab="preview">{m.tabs.preview}</button>
        <button type="button" role="tab" id="tab-change" aria-controls="panel-change" aria-selected="false" tabindex="-1" data-tab="change">{m.tabs.change}</button>
        <button type="button" role="tab" id="tab-texts" aria-controls="panel-texts" aria-selected="false" tabindex="-1" data-tab="texts">{m.tabs.texts}</button>
        <button type="button" role="tab" id="tab-photos" aria-controls="panel-photos" aria-selected="false" tabindex="-1" data-tab="photos">{m.tabs.photos}</button>
        <button type="button" role="tab" id="tab-domain" aria-controls="panel-domain" aria-selected="false" tabindex="-1" data-tab="domain">{m.tabs.domain}</button>
      </div>
      <!-- Under the tabs: the Celular/Computador switch, only on Vista previa. -->
      <div class="site-bar">
        <div class="viewport" role="group" aria-label={m.viewport.label} data-viewport>
          <button type="button" data-width="phone" aria-pressed="false">{m.viewport.phone}</button>
          <button type="button" data-width="desktop" aria-pressed="true">{m.viewport.desktop}</button>
        </div>
      </div>
      <p class="notice" data-notice role="status" aria-live="polite"></p>

      <div class="tabpanel" role="tabpanel" id="panel-preview" aria-labelledby="tab-preview" data-panel="preview">
        <div class="device" data-width="desktop">
          <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span data-chrome-name></span></div>
          <iframe title={m.heading} sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"></iframe>
        </div>
      </div>

      <div class="tabpanel" role="tabpanel" id="panel-change" aria-labelledby="tab-change" data-panel="change" hidden>
        <div class="change-layout">
        <div>
        <ChatThread lang={lang} vos={vos} boxed />
        </div>
        <div class="handoff" data-handoff>
          <div class="qr" data-qr></div>
          <div>
            <h3>{m.qr.title}</h3>
            <p>{m.qr.text}</p>
          </div>
        </div>
        </div>
        {/* Delete: hidden for now (remove `hidden` to show it again). */}
        <div class="danger" hidden>
          <div class="line"><button class="linkbtn" type="button" data-delete>{m.delete}</button></div>
        </div>
      </div>

      {/* Every text on the page, changed in place (no redesign). Filled by my-site.ts from GET /me. */}
      <div class="tabpanel texts-panel" role="tabpanel" id="panel-texts" aria-labelledby="tab-texts" data-panel="texts" hidden>
        <p class="lead">{x.intro}</p>
        <p class="hint" data-texts-none hidden>{x.none}</p>
        <form data-texts-form novalidate>
          <div data-texts></div>
          <div class="texts-save">
            <p class="notice" data-kind="error" data-texts-error role="alert"></p>
            <button class="btn" type="submit" data-texts-save disabled>{x.save}</button>
          </div>
        </form>
      </div>

      {/* The owner's logo and photos: take some out, add new ones; saving starts a redesign that places them. */}
      <div class="tabpanel photos-panel" role="tabpanel" id="panel-photos" aria-labelledby="tab-photos" data-panel="photos" hidden>
        <p class="lead">{p.intro}</p>
        <form data-photos-form novalidate>
          <section>
            <h3>{p.logo}</h3>
            <ul class="thumbs current" data-current="logo"></ul>
            <label class="sub" for="mp-logo" data-logo-label data-add={p.addLogo} data-change={p.changeLogo}>{p.addLogo}</label>
            <input type="file" id="mp-logo" name="logo" accept="image/*" />
            <ul class="thumbs" data-thumbs="logo"></ul>
          </section>
          <section>
            <h3>{p.pics}</h3>
            <p class="hint" data-no-photos>{p.none}</p>
            <ul class="thumbs current" data-current="photos"></ul>
            <label class="sub" for="mp-photos">{p.add}</label>
            <input type="file" id="mp-photos" name="photos" accept="image/*" multiple />
            <ul class="thumbs" data-thumbs="photos"></ul>
          </section>
          <p class="notice" data-kind="error" data-photos-error role="alert"></p>
          <div><button class="btn" type="submit" data-photos-save disabled>{p.save}</button></div>
        </form>
        {/* The photos the page writer made: each can be swapped for one of the owner's, in the same place (no redesign). */}
        <section class="made-photos" data-made-section hidden>
          <h3>{p.made.title}</h3>
          <p class="hint">{p.made.intro}</p>
          <ul class="thumbs current" data-made></ul>
          <p class="notice" data-kind="error" data-made-error role="alert"></p>
          <div><button class="btn" type="button" data-made-save disabled>{p.made.save}</button></div>
        </section>
      </div>

      <div class="tabpanel domain" role="tabpanel" id="panel-domain" aria-labelledby="tab-domain" data-panel="domain" data-domain="loading" hidden>
        <section class="ticket domain-owned" data-domain-view="owned">
          {/* A browser at the new address, stamped with a check. */}
          <svg class="domain-art" viewBox="0 0 260 165" width="260" height="165" aria-hidden="true">
            <g class="window">
              <rect x="20" y="18" width="190" height="124" rx="10" fill="var(--ink)" transform="translate(7 7)" />
              <rect x="20" y="18" width="190" height="124" rx="10" fill="#fffaf0" stroke="var(--ink)" stroke-width="5" />
              <path d="M30 18h170a10 10 0 0 1 10 10v20H20V28a10 10 0 0 1 10-10z" fill="var(--azul)" stroke="var(--ink)" stroke-width="5" stroke-linejoin="round" />
              <circle cx="37" cy="33" r="4.5" fill="var(--rojo)" stroke="var(--ink)" stroke-width="2.5" />
              <circle cx="51" cy="33" r="4.5" fill="var(--amarillo)" stroke="var(--ink)" stroke-width="2.5" />
              <circle cx="65" cy="33" r="4.5" fill="var(--verde)" stroke="var(--ink)" stroke-width="2.5" />
              <rect x="34" y="60" width="162" height="22" rx="11" fill="var(--paper)" stroke="var(--ink)" stroke-width="4" />
              <circle cx="48" cy="71" r="6" fill="var(--celeste)" stroke="var(--ink)" stroke-width="2.5" />
              <path d="M42 71h12M48 65c-3 4-3 8 0 12M48 65c3 4 3 8 0 12" fill="none" stroke="var(--ink)" stroke-width="1.6" />
              <path d="M62 71h74" stroke="var(--ink)" stroke-width="5" stroke-linecap="round" />
              <rect x="34" y="94" width="66" height="36" rx="5" fill="var(--amarillo)" stroke="var(--ink)" stroke-width="3.5" />
              <path d="M40 124l14-14 10 9 8-6 22 11" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" />
              <g stroke="var(--ink)" stroke-width="4" stroke-linecap="round" opacity=".55">
                <path d="M112 100h60M112 112h46M112 124h54" />
              </g>
            </g>
            <g class="seal">
              <circle cx="214" cy="126" r="27" fill="var(--ink)" transform="translate(5 5)" />
              <circle cx="214" cy="126" r="27" fill="var(--amarillo)" stroke="var(--ink)" stroke-width="5" />
              <path d="M201 127l9 9 17-18" fill="none" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
            </g>
            <path class="spark" d="M240 8l4 10 10 4-10 4-4 10-4-10-10-4 10-4z" fill="var(--amarillo)" stroke="var(--ink)" stroke-width="3.5" stroke-linejoin="round" />
            <path class="spark" d="M8 104l2.5 6 6 2.5-6 2.5-2.5 6-2.5-6-6-2.5 6-2.5z" fill="var(--rojo)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" />
          </svg>
          <header>
            <h2 data-domain-name></h2>
          </header>
          <p class="lead" data-domain-status></p>
          <p class="next">{d.later}</p>
        </section>

        <section data-domain-view="search">
          <h2>{d.title}</h2>
          <p>{d.intro}</p>
          <form class="domain-search" data-domain-search role="search">
            <label class="sub" for="domain-q">{d.searchLabel}</label>
            <div class="domain-row">
              <span class="domain-input">
                <input type="text" id="domain-q" name="q" maxlength="63" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" inputmode="url" required />
                <span class="suffix" aria-hidden="true">.com</span>
              </span>
              <button class="btn small" type="submit">{d.searchButton}</button>
            </div>
          </form>
          <p class="hint" data-domain-closed hidden>{d.closed}</p>
          <p class="notice" data-kind="error" data-domain-search-error role="alert"></p>
          <ul class="domain-results" data-domain-results aria-live="polite"></ul>
        </section>

        <form class="ticket domain-confirm" data-domain-view="confirm" data-domain-confirm>
          <header>
            <h2 data-domain-chosen></h2>
          </header>
          <p class="lead">{d.confirm.intro}</p>
          <p class="notice" data-kind="error" data-domain-error role="alert"></p>
          <div class="submit-row">
            <button class="btn" type="submit" data-domain-submit>{d.confirm.submit}</button>
            <button class="linkbtn" type="button" data-domain-back>{d.confirm.back}</button>
          </div>
        </form>
      </div>

    </section>
  </div>
</Layout>

<script>
  import '../scripts/my-site';
</script>
