---
import Layout from '../layouts/Layout.astro';
import { t, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const m = s.mySite;
const f = m.fields;
const other = t(s.otherLang.code);
const clientStrings = { ...m, question: s.questions, previewPath: s.paths.preview };
---

<Layout lang={lang} title={m.title} description={m.description} alternate={other.paths.mySite} withConfig>
  <div class="mysite wrap" id="mysite" data-state="loading" data-strings={JSON.stringify(clientStrings)}>
    <section data-view="loading" class="panel"><div class="paint" aria-hidden="true"></div></section>

    <section data-view="message" class="panel" aria-live="assertive">
      <h2 data-message-title></h2>
      <p data-message-text></p>
    </section>

    <section data-view="working" class="panel" aria-live="polite">
      <h2>{m.working.title}</h2>
      <div class="paint" aria-hidden="true"></div>
      <p class="hint">{m.working.note}</p>
    </section>

    <section data-view="questions">
      <form class="ticket" data-questions novalidate>
        <header>
          <h2>{m.questionsTitle}</h2>
          <p>{s.questions.intro}</p>
        </header>
        <div data-question-list></div>
        <div class="submit-row">
          <button class="btn" type="submit">{m.questionsSubmit}</button>
          <button class="btn ghost" type="button" data-skip>{s.questions.skip}</button>
        </div>
      </form>
    </section>

    <section data-view="editor">
      <header>
        <h1 data-business>{m.heading}</h1>
        <div class="viewport" role="group" aria-label={m.viewport.label}>
          <button type="button" data-width="phone" aria-pressed="true">{m.viewport.phone}</button>
          <button type="button" data-width="desktop" aria-pressed="false">{m.viewport.desktop}</button>
        </div>
      </header>
      <p class="notice" data-notice role="status" aria-live="polite"></p>

      <div class="layout">
        <div>
          <div class="device" data-width="phone"><iframe title={m.heading} sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"></iframe></div>
          <p class="hint">{m.private} <a data-draft-link target="_blank" rel="noopener">{m.open}</a></p>
        </div>

        <div>
          <form class="ticket" data-edit novalidate>
            <fieldset>
              <label class="q" for="instruction">{m.change.label}</label>
              <p class="hint" id="instruction-hint">{m.change.hint}</p>
              <textarea id="instruction" name="instruction" maxlength="1000" aria-describedby="instruction-hint" placeholder={m.change.placeholder}></textarea>
            </fieldset>
            <div class="submit-row">
              <button class="btn" type="submit">{m.change.submit}</button>
              <button class="btn ghost" type="button" data-undo>{m.undo}</button>
            </div>
          </form>

          <form class="ticket" data-contact novalidate style="margin-top: 2rem">
            <fieldset>
              <legend class="q">{f.title}</legend>
              <label class="sub" for="whatsapp">{f.whatsapp}</label>
              <input type="tel" id="whatsapp" name="whatsapp" maxlength="40" inputmode="tel" autocomplete="tel" />
              <label class="sub" for="phone">{f.phone}</label>
              <input type="tel" id="phone" name="phone" maxlength="40" inputmode="tel" />
              <label class="sub" for="email">{f.email}</label>
              <input type="email" id="email" name="email" maxlength="120" autocapitalize="none" autocomplete="email" />
              <label class="sub" for="address">{f.address}</label>
              <input type="text" id="address" name="address" maxlength="160" autocomplete="street-address" />
              <div class="two">
                <div><label class="sub" for="instagram">{f.instagram}</label><input type="text" id="instagram" name="instagram" maxlength="200" autocapitalize="none" placeholder="@" /></div>
                <div><label class="sub" for="facebook">{f.facebook}</label><input type="text" id="facebook" name="facebook" maxlength="200" autocapitalize="none" /></div>
              </div>
            </fieldset>
            <div class="submit-row"><button class="btn small" type="submit">{m.saveContact}</button></div>
          </form>

          <div class="danger">
            <div class="line"><button class="linkbtn" type="button" data-delete>{m.delete}</button></div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '../scripts/my-site';
</script>
