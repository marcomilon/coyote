---
import '../styles/global.css';
import { t, type Lang } from '../i18n/strings';
import { countriesFor, DEFAULT_COUNTRY, WHATSAPP, whatsappLink } from '../config/landing';

interface Props {
  lang: Lang;
  /** Spanish with vos: the pages under /vos/, which CloudFront serves at the usual URLs in voseo countries. */
  vos?: boolean;
  title: string;
  description: string;
  /** Path of this page in the other language. */
  alternate: string;
  /** Loads /config.js (the API URL). Only pages that call the API need it. */
  withConfig?: boolean;
  /** Pages for one owner (Mi sitio, the chat, Mis sitios): kept out of search engines. */
  noindex?: boolean;
  /** The home page: its header links to its own sections and has the country picker. Other pages show only the logo. */
  home?: boolean;
}
const { lang, vos = false, title, description, alternate, withConfig = false, noindex = false, home = false } = Astro.props;
const s = t(lang, vos);
const support = whatsappLink(lang);
// Absolute links need the site's address (astro.config.mjs); a domainless build leaves them out.
const site = Astro.site;
// The address as the app links it: no trailing slash, except on the two home pages ('/' and '/pt/').
const homes: string[] = [t('es').paths.home, t('pt').paths.home];
// A vos page is the same page as its tú twin (cf-app-rewrite.js serves it at that URL): links and canonical name it.
const pathname = Astro.url.pathname.replace(/^\/vos(?=\/|$)/, '') || '/';
const path = homes.includes(pathname) ? pathname : pathname.replace(/\/$/, '');
const here = site && new URL(path, site).href;
const there = site && new URL(alternate, site).href;
const [es, pt] = lang === 'es' ? [here, there] : [there, here];
---

<!doctype html>
<html lang={s.htmlLang} data-voice={vos ? 'vos' : undefined} data-alternate={alternate}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    {
      site ? (
        <>
          {!noindex && (
            <>
              <link rel="canonical" href={here} />
              <link rel="alternate" hreflang="es" href={es} />
              <link rel="alternate" hreflang="pt" href={pt} />
              <link rel="alternate" hreflang="x-default" href={es} />
            </>
          )}
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="ventas314.com" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={here} />
          <meta property="og:image" content={new URL('/og.png', site).href} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:locale" content={lang === 'es' ? 'es_LA' : 'pt_BR'} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      ) : (
        <link rel="alternate" hreflang={s.otherLang.code} href={alternate} />
      )
    }
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bungee&family=Hanken+Grotesk:wght@400;500;600;700&family=Yellowtail&display=swap"
    />
    {withConfig && <script is:inline src="/config.js" />}
  </head>
  <body>
    <header class:list={["site-header wrap", { home }]}>
      <div class="brand"><a href={s.paths.home}><img src="/logo.png" alt="ventas314.com" width="668" height="132" /></a><span>{s.brandTagline}</span></div>
      {/* Only the home page has links here; every other page shows just the logo. */}
      {
        home && (
          <nav class="home-nav">
            <span class="nav-links">
              <a href="#precio">{s.home.nav.price}</a>
              <a href="#ejemplos">{s.home.nav.examples}</a>
              <a href={s.paths.mySites}>{s.nav.mySites}</a>
            </span>
            <select class="country" data-country-select data-default={DEFAULT_COUNTRY[lang]} aria-label={s.home.nav.country}>
              {countriesFor(lang).map((c) => (
                <option value={c.code} selected={c.code === DEFAULT_COUNTRY[lang]}>
                  {c.flag} {c.name[lang]}
                </option>
              ))}
            </select>
            <a class="btn small" href={s.paths.create}>{s.nav.create}</a>
          </nav>
        )
      }
      <slot name="account" />
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="about">
          <b>© {s.footer.made}</b>
          {support && WHATSAPP.display && <span>{s.footer.support} <a href={support}>{WHATSAPP.display}</a></span>}
        </div>
        <nav>
          <a href={s.paths.terms}>{s.footer.terms}</a>
          <a href={s.paths.privacy}>{s.footer.privacy}</a>
          <a href={s.paths.refunds}>{s.footer.refunds}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
