---
import Layout from './Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import type { Lang } from '../i18n/strings';

interface Props {
  frontmatter: { lang: Lang; title: string; description: string; alternate: string; vos?: boolean };
}
const { lang, title, description, alternate, vos = false } = Astro.props.frontmatter;
---

<Layout lang={lang} vos={vos} title={`${title} — ventas314.com`} description={description} alternate={alternate}>
  <Breadcrumb lang={lang} vos={vos} current={title} wrap />
  <article class="legal wrap">
    <h1>{title}</h1>
    <slot />
  </article>
</Layout>
